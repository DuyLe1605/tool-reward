{
    "name": "bing-rewards-tool",
    "description": "Microsoft Rewards Auto Search Tool",
    "version": "9.0.4",
    "main": "dist-electron/main.js",
    "scripts": {
        "start": "ts-node --project tsconfig.json src/cli.ts",
        "web": "ts-node --project tsconfig.json server/index.ts",
        "web:build": "cd web && npm run build",
        "dev": "cd web && npm run dev",
        "build:server": "tsc --project tsconfig.json",
        "build:electron": "tsc --project tsconfig.electron.json",
        "electron:dev": "npm run build:electron && electron .",
        "release:local": "npm run build:server && npm run web:build && npm run build:electron && electron-builder --dir --config.asar=false --publish never && echo. && echo [OK] Build xong! Chay thu tai: %CD%\\release\\win-unpacked\\Rewards Tool.exe && echo.",
        "release:build": "npm run build:server && npm run web:build && npm run build:electron && electron-builder --publish never",
        "release:publish": "npm run build:server && npm run web:build && npm run build:electron && electron-builder --publish always"
    },
    "dependencies": {
        "electron-log": "^5.3.4",
        "electron-updater": "^6.6.2",
        "express": "^5.2.1",
        "playwright": "^1.59.1",
        "playwright-core": "^1.59.1",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.1",
        "@types/ws": "^8.18.1",
        "electron": "^36.3.1",
        "electron-builder": "^26.0.12",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "build": {
        "appId": "com.brewmonster.rewards-tool",
        "productName": "Rewards Tool",
        "copyright": "DuyLe1605",
        "asar": true,
        "directories": {
            "output": "release",
            "buildResources": "assets"
        },
        "files": [
            "dist-electron/**",
            "dist/**",
            "web/dist/**",
            "node_modules/**",
            "package.json",
            "!node_modules/playwright/.local-browsers/**",
            "!node_modules/playwright-core/.local-browsers/**",
            "!**/*.map",
            "!**/test/**",
            "!**/tests/**",
            "!**/*.spec.*",
            "!**/*.test.*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.ico",
            "requestedExecutionLevel": "requireAdministrator"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "assets/icon.ico",
            "uninstallerIcon": "assets/icon.ico",
            "installerHeaderIcon": "assets/icon.ico",
            "shortcutName": "Rewards Tool",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "runAfterFinish": true
        },
        "publish": {
            "provider": "github",
            "owner": "DuyLe1605",
            "repo": "tool-reward",
            "releaseType": "release"
        }
    }
}
